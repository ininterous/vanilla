			<Item class="Script" referent="RBX239">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">local noob = script.Parent
local hum = noob.Humanoid
local torso = noob.Torso
--_gc is interesting im glad that i discovered it :P
while _G.Jack == nil do wait(0.1) end
local jack = _G.Jack
local jackHum = jack.Humanoid

local cooldown = 1.2
local canAttack = true
local distLimit = 35
local paralyzed = false

hum.WalkSpeed = 10

hum.Died:connect(function()
	game.Debris:AddItem(noob, 3)
end)

local function onTouched(hit)
	if hit.Parent == jack then
		paralyzed = true
		hum.WalkSpeed = 0
	end
end

local kids = noob:GetChildren()
for i = 1, #kids do
	if kids[i].className == &quot;Part&quot; then
		kids[i].Touched:connect(onTouched)
	end
end

local function getJackTarget()
	local parts = jack:GetChildren()
	local nearPart = nil
	local nearDist = 99999
	
	for i = 1, #parts do
		local item = parts[i]
		if item.className == &quot;Part&quot; then
			local d = (torso.Position - item.Position).magnitude
			if d &lt; nearDist then
				nearPart = item
				nearDist = d
			end
		end
	end
	return nearPart
end

while true do
	if hum.Health &lt;= 0 or jackHum.Health &lt;= 0 then break end
	
	if paralyzed then
		if canAttack then
			canAttack = false
			jackHum.Health = jackHum.Health - 50
			wait(cooldown)
			canAttack = true
		end
	else
		local players = game.Players:GetChildren()
		local targetPlayer = nil
		local closest = distLimit
		
		for i = 1, #players do
			local p = players[i]
			if p.Character ~= nil and p.Character:FindFirstChild(&quot;Torso&quot;) ~= nil and p.Character:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
				if p.Character.Humanoid.Health &gt; 0 then
					local d = (torso.Position - p.Character.Torso.Position).magnitude
					if d &lt; closest then
						targetPlayer = p.Character
						closest = d
					end
				end
			end
		end
		
		local targetPart = nil
		local targetHum = nil
		
		if targetPlayer ~= nil then
			targetPart = targetPlayer.Torso
			targetHum = targetPlayer.Humanoid
		elseif jackHum.Health &gt; 0 then
			targetPart = getJackTarget()
			targetHum = jackHum
		end
		
		if targetPart ~= nil and targetHum ~= nil then
			hum:MoveTo(targetPart.Position, targetPart)
			
			local currentDist = (torso.Position - targetPart.Position).magnitude
			
			if currentDist &lt; 8 and canAttack then
				canAttack = false
				
				local oldSpeed = hum.WalkSpeed
				hum.WalkSpeed = 35
				wait(0.15)
				
				if (torso.Position - targetPart.Position).magnitude &lt; 10 then
					if targetPart.Parent == jack then
						targetHum.Health = targetHum.Health - 75
					else
						targetHum.Health = targetHum.Health - 10
					end
				end
				
				if not paralyzed then
					hum.WalkSpeed = oldSpeed
				end
				wait(cooldown)
				canAttack = true
			end
		end
	end
	
	wait(0.2)
end</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
		<Item class="Sky" referent="RBX240">
