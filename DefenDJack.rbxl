					<string name="Name">PelletScript</string>
					<string name="Source">local debris = game:service(&quot;Debris&quot;)
pellet = script.Parent
damage = 16

function onTouched(hit)
	local target = hit.Parent
	local humanoid = target:findFirstChild(&quot;Humanoid&quot;)
	
	if humanoid == nil and target.Parent ~= nil then
		target = target.Parent
		humanoid = target:findFirstChild(&quot;Humanoid&quot;)
	end
	
	if humanoid ~= nil and string.find(target.Name, &quot;Noob&quot;) then
		tagHumanoid(humanoid)
		humanoid:TakeDamage(damage)
		connection:disconnect()
		pellet.Parent = nil
	else
		damage = damage / 2
		if damage &lt; 1 then
			connection:disconnect()
			pellet.Parent = nil
		end
	end
end

function tagHumanoid(humanoid)
	local tag = pellet:findFirstChild(&quot;creator&quot;)
	if tag ~= nil then
		while(humanoid:findFirstChild(&quot;creator&quot;) ~= nil) do
			humanoid:findFirstChild(&quot;creator&quot;).Parent = nil
		end

		local new_tag = tag:clone()
		new_tag.Parent = humanoid
		debris:AddItem(new_tag, 1)
	end
end

connection = pellet.Touched:connect(onTouched)

r = game:service(&quot;RunService&quot;)
t, s = r.Stepped:wait()
d = t + 2.0 - s
while t &lt; d do
	t = r.Stepped:wait()
end

if pellet.Parent ~= nil then
	pellet.Parent = nil
end</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX192">
