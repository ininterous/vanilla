		<Item class="Script" referent="RBX8">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">wave</string>
				<string name="Source">local lighting = game.Lighting
local jack = game.Workspace.jack
local jackHum = jack.Humanoid

_G.Jack = jack

local noob = lighting.Noob
local fastNoob = lighting:FindFirstChild(&quot;Fast Noob&quot;)
local noob08 = lighting:FindFirstChild(&quot;Noob &apos;08&quot;)
local ghostNoob = lighting:FindFirstChild(&quot;Ghost Noob&quot;)
local buffNoob = lighting:FindFirstChild(&quot;Buff Noob&quot;)
local firebrand = lighting:FindFirstChild(&quot;XCBLOX Guardians Sword&quot;)
local maxWaves = 10
local totalSpawns = 12

math.randomseed(tick())

local function showMsg(txt, t)
    local players = game.Players:GetPlayers()
    local msgs = {}

    for i = 1, #players do
        local msg = Instance.new(&quot;Message&quot;)
        msg.Parent = players[i]
        msgs[i] = msg
    end

    local acumulado = &quot;&quot;
    for i = 1, string.len(txt) do
        acumulado = acumulado .. string.sub(txt, i, i)
        for j = 1, #msgs do
            msgs[j].Text = acumulado
        end
        wait(0.04)
    end

    wait(t)

    for j = 1, #msgs do
        msgs[j]:Remove()
    end
end

local function countNoobs()
    local children = game.Workspace:GetChildren()
    local count = 0
    for i = 1, #children do
        if children[i].Name ~= &quot;Noobs:&quot; and string.find(children[i].Name, &quot;Noob&quot;) then
            local h = children[i]:FindFirstChild(&quot;Humanoid&quot;)
            if h ~= nil and h.Health &gt; 0 then
                count = count + 1
            end
        end
    end
    return count
end

delay(0, function()
    local noobCounter = game.Workspace:FindFirstChild(&quot;Noobs:&quot;)
    while true do
        if jackHum then
            local currentHealth = math.max(0, math.floor(jackHum.Health))
            jack.Name = &quot;jack [&quot; .. currentHealth .. &quot;/10000]&quot;
        end
        
        if noobCounter then
            noobCounter.Name = &quot;Noobs: &quot; .. countNoobs()
        end
        
        wait(0.2)
    end
end)

while #game.Players:GetPlayers() == 0 do
	wait(1)
end

local introTime = 15
local introPlayers = game.Players:GetPlayers()
local introMsgs = {}

for i = 1, #introPlayers do
	local msg = Instance.new(&quot;Message&quot;)
	msg.Parent = introPlayers[i]
	msg.Text = &quot;The game starts in &quot; .. introTime .. &quot; seconds...&quot;
	introMsgs[i] = msg
end

for i = introTime - 1, 0, -1 do
	wait(1)
	for j = 1, #introMsgs do
		introMsgs[j].Text = &quot;The game starts in &quot; .. i .. &quot; seconds...&quot;
	end
end

for j = 1, #introMsgs do
	introMsgs[j]:Remove()
end

for wave = 1, maxWaves do
    if wave == 1 then
        jackHum.MaxHealth = 10000
        wait(0.1)
        jackHum.Health = 10000
    end

    if jackHum.Health &lt;= 0 then break end
    
    showMsg(&quot;wave &quot; .. wave .. &quot; is starting&quot;, 4)
    wait(2)
    
    if wave == 5 then
        showMsg(&quot;Things are going to be harder now. Here is your rewards:&quot;, 5)
        wait(1)

        if firebrand ~= nil then
            local players = game.Players:GetPlayers()
            for p = 1, #players do
                local backpack = players[p]:FindFirstChild(&quot;Backpack&quot;)
                if backpack ~= nil then
                    if not backpack:FindFirstChild(&quot;XCBLOX Guardians Sword&quot;) and not (players[p].Character and players[p].Character:FindFirstChild(&quot;Firebrand&quot;)) then
                        local weaponClone = firebrand:Clone()
                        weaponClone.Parent = backpack
                    end
                end
            end
        end
    end
    
    local count = 5
    if wave &gt;= 2 then
        if wave &gt;= 7 then
            count = 35
        else
            count = wave * 5
        end
    end
    
    local availableNumbers = {}
    for n = 1, totalSpawns do
        table.insert(availableNumbers, n)
    end
    
    for i = 1, count do
        if jackHum.Health &lt;= 0 then break end
        
        if #availableNumbers == 0 then
            for n = 1, totalSpawns do
                table.insert(availableNumbers, n)
            end
        end
        
        local index = math.random(1, #availableNumbers)
        local spawnNumber = availableNumbers[index]
        table.remove(availableNumbers, index)
        
        local spawnName = &quot;NoobSpawn&quot; .. spawnNumber
        local selectedSpawn = game.Workspace:findFirstChild(spawnName)
        
        local pos
        if selectedSpawn ~= nil then
            local rx = math.random(-4, 4)
            local rz = math.random(-4, 4)
            pos = selectedSpawn.Position + Vector3.new(rx, 5, rz)
        else
            local rx = math.random(-40, 40)
            local rz = math.random(-40, 40)
            pos = jack.Torso.Position + Vector3.new(rx, 6, rz)
        end
        
        local enemy = noob
        fastNoob = lighting:FindFirstChild(&quot;Fast Noob&quot;)
        noob08 = lighting:FindFirstChild(&quot;Noob &apos;08&quot;)
        ghostNoob = lighting:FindFirstChild(&quot;Ghost Noob&quot;)
        buffNoob = lighting:FindFirstChild(&quot;Buff Noob&quot;)
        
        if wave == 2 or wave == 3 then
            local sorteio = math.random(1, 100)
            if sorteio &lt;= 30 and fastNoob ~= nil then
                enemy = fastNoob
            elseif sorteio &gt; 30 and sorteio &lt;= 60 and noob08 ~= nil then
                enemy = noob08
            end
        elseif wave == 4 then
            local sorteio = math.random(1, 100)
            if sorteio &lt;= 25 and fastNoob ~= nil then
                enemy = fastNoob
            elseif sorteio &gt; 25 and sorteio &lt;= 50 and noob08 ~= nil then
                enemy = noob08
            elseif sorteio &gt; 50 and sorteio &lt;= 75 and ghostNoob ~= nil then
                enemy = ghostNoob
            end
        elseif wave &gt;= 5 then
            local sorteio = math.random(1, 100)
            if sorteio &lt;= 20 and fastNoob ~= nil then
                enemy = fastNoob
            elseif sorteio &gt; 20 and sorteio &lt;= 40 and noob08 ~= nil then
                enemy = noob08
            elseif sorteio &gt; 40 and sorteio &lt;= 60 and ghostNoob ~= nil then
                enemy = ghostNoob
            elseif sorteio &gt; 60 and sorteio &lt;= 80 and buffNoob ~= nil then
                enemy = buffNoob
            end
        end
        
        local clone = enemy:Clone()
        
        local h = clone:FindFirstChild(&quot;Humanoid&quot;)
        if h ~= nil then
            h.Health = h.MaxHealth
        end
        
        clone.Parent = game.Workspace
        clone:MakeJoints()
        
        if clone:FindFirstChild(&quot;Torso&quot;) ~= nil then
            clone.Torso.CFrame = CFrame.new(pos)
        end
        
        if h ~= nil then
            h.Health = h.MaxHealth
        end
        
        wait(1.4)
    end
    
    while countNoobs() &gt; 0 do
        if jackHum.Health &lt;= 0 then break end
        wait(1)
    end
    
    if jackHum.Health &lt;= 0 then break end
    
    if wave &lt; maxWaves then
        showMsg(&quot;next wave in 10 seconds...&quot;, 5)
        wait(10) 
    end
end

if jackHum.Health &gt; 0 then
    while true do
        showMsg(&quot;jack has been defended! you are a hero for XCBLOXia&quot;, 5)
        wait(5)
    end
else
    while true do
        showMsg(&quot;YOU FAILED TO DEFEND JACK!!!!!! &quot;, 5)
        wait(5)
    end
end</string>
