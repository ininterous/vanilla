		<Item class="Sound" referent="RBX173">
			<Properties>
				<bool name="Looped">false</bool>
				<string name="Name">Battle music</string>
				<int name="PlayCount">-1</int>
				<bool name="PlayOnRemove">false</bool>
				<Content name="SoundId"><url>http://xcblox.com/asset/audio/?id=2168</url></Content>
				<float name="Volume">0.5</float>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="IntValue" referent="RBX174">
				<Properties>
					<string name="Name">Len</string>
					<int name="Value">130</int>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
		<Item class="Script" referent="RBX175">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">music</string>
				<string name="Source">local container = script.Parent
local songs = {}

local children = container:GetChildren()
for i = 1, #children do
    if children[i].className == &quot;Sound&quot; then
        table.insert(songs, children[i])
    end
end

if #songs == 0 then
    print(&quot;no music found&quot;)
    return
end

local cur = 1

while true do
    local currentSong = songs[cur]
    
    if currentSong ~= nil then

        local success, err = pcall(function()
            currentSong:play()
        end)

        if success then
            print(&quot;playing: &quot;, currentSong.Name)

            local waitTime = 130
            local lenObj = currentSong:FindFirstChild(&quot;Len&quot;)
            if lenObj ~= nil then
                waitTime = lenObj.Value
            end

            wait(waitTime)

            pcall(function() currentSong:stop() end)
        else
            print(&quot;failed to play: &quot;, currentSong.Name, &quot; - &quot;, err)
            wait(2)
        end
    end
    
    cur = cur + 1
    if cur &gt; #songs then
        cur = 1
    end
    
    wait(1)
end</string>
				<bool name="archivable">true</bool>
