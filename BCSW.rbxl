				<Item class="Script" referent="RBX590">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">local engine = script.Parent.Parent.Engine
local bodyforce = engine.Hover
local car = script.Parent.Parent



local debounce = false




function onTouched(hit)
	local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if humanoid~=nil and debounce == false then
		debounce = true
		
		script.Parent.BrickColor = BrickColor.new(21)

		wait(0)
		engine.Anchored = false
		wait(0.1)
		bodyforce.position = Vector3.new(-92.5, 18.6, -26.5)
		wait(3)
		bodyforce.position = Vector3.new(-92.5, -1.2, -26.5)
		wait(1)
		engine.Anchored = true

			
	

		script.Parent.BrickColor = BrickColor.new(28)

		wait(1)
	
		

		debounce = false
	end
end


script.Parent.Touched:connect(onTouched)


</string>
						<bool name="archivable">true</bool>
