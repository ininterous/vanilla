				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">function onHit(hit)
if script.Parent.Debounce.Value == 1 then
script.Parent.Debounce.Value = 0
while true do
wait(0.1)
if script.Parent.Value.Value &gt;= 20 then break end
script.Parent.CFrame = script.Parent.CFrame + Vector3.new(-0.05,0,0)
script.Parent.Value.Value = script.Parent.Value.Value +0.1
end
wait(5)
while true do
wait(0.1)
if script.Parent.Value.Value &lt;= 0 then break end
script.Parent.CFrame = script.Parent.CFrame + Vector3.new(0.05,0,0)
script.Parent.Value.Value = script.Parent.Value.Value -0.1
end
script.Parent.Value.Value = 0
script.Parent.Debounce.Value = 1
end
end


script.Parent.Touched:connect(onHit)</string>
					<bool name="archivable">true</bool>
				</Properties>
