				<Item class="Script" referent="RBX631">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">p = script.Parent
de = false

function Hit(hit)
local h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
if h ~= nil then
if de == false then
de = true
h.Parent.Torso.CFrame = p.Parent.CF.CFrame
s = Instance.new(&quot;Seat&quot;)
s.Name = &quot;PlayerSeat&quot;
s.formFactor = 2
s.Size = Vector3.new(4,4,4)
s.BrickColor = BrickColor.new(26)
s.Reflectance = 0.3
s.Transparency = 1
s.Parent = game.Workspace
s.CFrame = p.Parent.CF.CFrame
local l = p.Parent.Script:Clone()
local l2 = p.Parent.Script2:Clone()
l2.Disabled = false
l.Disabled = false
l.Parent = s
l2.Parent = s
wait(1)
de = false
end
end
end

p.Touched:connect(Hit)</string>
