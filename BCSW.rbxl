		<Item class="Script" referent="RBX1476">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">2edChanceGetter</string>
				<string name="Source">texture = &quot;http://www.roblox.com/asset/?id=2980194&quot;
wepname = &quot;2ed Chance&quot;
 
function spawned(player)
        wait(1)
        char = player.Character
        if char.Torso:findFirstChild(&quot;roblox&quot;) ~= nil then
                if char.Torso:findFirstChild(&quot;roblox&quot;).Texture == texture and game.Lighting:FindFirstChild(wepname) then
                        game.Lighting:FindFirstChild(wepname):Clone().Parent = player.Backpack
                end
        end
end               
        
 
function nP(newPlayer)
        newPlayer.Changed:connect(function (p) 
                if p == &quot;Character&quot; and newPlayer.Character ~= nil then
                        spawned(newPlayer)
                end
        end)
end
 
game.Players.PlayerAdded:connect(nP) 
</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
