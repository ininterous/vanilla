				<Item class="Script" referent="RBX763">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">local door1 = script.Parent.Parent.Door1
local door2 = script.Parent.Parent.Door2
local door3 = script.Parent.Parent.Door3

local debounce = false


function onTouched(hit)
	local humanoid = hit.Parent
	if humanoid~=nil and debounce == false then
		debounce = true

		script.Parent.BrickColor = BrickColor.new(26)
		script.Parent.Parent.Open.BrickColor = BrickColor.new(28)

		wait(0)

		door1.CanCollide = true
		door1.Transparency = 0.7
		door2.CanCollide = true
		door2.Transparency = 0.7
		door3.CanCollide = true
		door3.Transparency = 0.7

		wait(1)

		debounce = false
	end
end


script.Parent.Touched:connect(onTouched)</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
