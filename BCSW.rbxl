		<Item class="HopperBin" referent="RBX1643">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">KeyDown</string>
				<Content name="TextureId"><null></null></Content>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="NumberValue" referent="RBX1644">
				<Properties>
					<string name="Name">Debounce</string>
					<double name="Value">0</double>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX1645">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LocalScript</string>
					<string name="Source">bin = script.Parent

function onKeyDown(key)
	key = key:lower()

	local user = script.Parent.Parent.Parent.Character

	if key == &quot;q&quot; and bin.Debounce.Value==0 then
		bin.Debounce.Value = 1
		local p = Instance.new(&quot;Seat&quot;)
		p.formFactor = 0
		p.Size = Vector3.new(3,3,3)
		p.Transparency = 0.3
		p.BrickColor = BrickColor.new(26)
		p.Name = &quot;Seat&quot;
		p.Position = user.Torso.Position
		p.Parent = user
		wait() --Debounce Time
		bin.Debounce.Value = 0
	end

	if key == &quot;l&quot; and bin.Debounce.Value==0 then
		bin.Debounce.Value = 1
		user.Torso.roblox:remove()
		user.Head.face:remove()
		user:findFirstChild(&quot;Right Arm&quot;).Transparency = 1
		user:findFirstChild(&quot;Left Leg&quot;).Transparency = 1
		user:findFirstChild(&quot;Left Arm&quot;).Transparency = 1
		user:findFirstChild(&quot;Right Leg&quot;).Transparency = 1
		user.Head.Transparency = 1
		user.Torso.Transparency = 1
		wait() --Debounce Time
		bin.Debounce.Value = 0
	end

	if key == &quot;p&quot; and bin.Debounce.Value==0 then
		bin.Debounce.Value = 1
		user.Head.CanCollide = false
		user.Torso.CanCollide = false
		wait() --Debounce Time
		bin.Debounce.Value = 0
	end

	if key == &quot;f&quot; and bin.Debounce.Value==0 then
		bin.Debounce.Value = 1
		local c = script.Sense:Clone()
		c.Disabled = false
		c.Parent = user.Torso
		wait(2) --Debounce Time
		bin.Debounce.Value = 0
	end

	if key == &quot;k&quot; and bin.Debounce.Value==0 then
		bin.Debounce.Value = 1
		local p = Instance.new(&quot;Part&quot;)
		p.formFactor = 1
		p.Size = Vector3.new(11, 5, 141)
		p.Transparency = 0.3
		p.CanCollide = false
		p.BrickColor = BrickColor:Blue()
		p.Name = &quot;FastBlade&quot;
		p.CFrame = CFrame.new(1.28e+003, 4.4, 11.5)
		p.Parent = game.Workspace
		script.Kill:clone().Parent = p
		b = Instance.new(&quot;BodyPosition&quot;)
		b.maxForce = Vector3.new(900000000000000000000000000000,900000000000000000000000000000,900000000000000000000000000000)
		b.position = Vector3.new(1.28e+003, 4.4, 11.5)
		b.Parent = p
		wait(0.2)
		b.position = Vector3.new(-231, 0.5, 11.5)
		wait(1.5) --Debounce Time
		p:remove()
		bin.Debounce.Value = 0
	end

	if key == &quot;b&quot; and bin.Debounce.Value==0 then
		bin.Debounce.Value = 1
		local p = Instance.new(&quot;Part&quot;)
		p.Size = Vector3.new(2, 82.8, 141)
		p.Transparency = 0.7
		p.CanCollide = false
		p.Anchored = true
		p.BrickColor = BrickColor.new(26)
		p.Name = &quot;ForceField&quot;
		p.CFrame = CFrame.new(-63, 43.3, 11.5)
		p.Parent = user
		script.BBS.Tramp:clone().Parent = p
		local s = Instance.new(&quot;Part&quot;)
		s.Size = Vector3.new(14, 14, 14)
		s.formFactor = 0
		s.Transparency = 0.7
		s.CanCollide = true
		s.Anchored = true
		s.TopSurface = 0
		s.BottomSurface = 0
		s.BrickColor = BrickColor.new(26)
		s.Name = &quot;Barrior&quot;
		s.CFrame = CFrame.new(-197, 4.9, 11)
		s.Parent = user
		script.BBS.Mesh:clone().Parent = s
		script.BBS.Script2:clone().Parent = s
		bin.Debounce.Value = 0
	end

	if key == &quot;u&quot; and bin.Debounce.Value==0 then
		bin.Debounce.Value = 1
		user.Humanoid.MaxHealth = 
		wait() --Debounce Time
		bin.Debounce.Value = 0
	end

	if key == &quot;e&quot; and bin.Debounce.Value==0 then
		bin.Debounce.Value = 1
		user.Torso.CFrame = CFrame.new(1.24e+003, 7.1, -91)
		wait() --Debounce Time
		bin.Debounce.Value = 0
	end

	if key == &quot;r&quot; and bin.Debounce.Value==0 then
		bin.Debounce.Value = 1
		user.Torso.CFrame = CFrame.new(-156, 6.5, -110)
		wait() --Debounce Time
		bin.Debounce.Value = 0
	end

	if key == &quot;t&quot; and bin.Debounce.Value==0 then
		bin.Debounce.Value = 1
		user.Torso.CFrame = CFrame.new(-113, 58.9, -82)
		wait() --Debounce Time
		bin.Debounce.Value = 0
	end

	if key == &quot;g&quot; and bin.Debounce.Value==0 then
		bin.Debounce.Value = 1
		local eng = game.Workspace.wall.BigEngine
		local bforce = eng.BodyForce
		wait(1)
		eng.Anchored = false
		bforce.force = Vector3.new(-55000000,0,0)
		wait() --Debounce Time
		bin.Debounce.Value = 0
	end

	if key == &quot;z&quot; and bin.Debounce.Value==0 then
		bin.Debounce.Value = 1
		local eng = game.Workspace.wall.BigEngine
		eng.Anchored = true
		wait() --Debounce Time
		bin.Debounce.Value = 0
	end

	if key == &quot;x&quot; and bin.Debounce.Value==0 then
		bin.Debounce.Value = 1
		local eng = game.Workspace.wall.BigEngine
		eng.Anchored = false
		wait() --Debounce Time
		bin.Debounce.Value = 0
	end
end

function onSelected(mouse)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.KeyDown:connect(onKeyDown)
end

bin.Selected:connect(onSelected)

-- what is here: Q, L, P, F, K, B, U, E, R, T, G, Z, X.</string>
					<bool name="archivable">true</bool>
