				<Item class="Script" referent="RBX2002">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script2</string>
						<string name="Source">--	~~~NZ~~~

function onTouch(part)
	if (part.Name == &quot;BackWall&quot;) then -- Change &quot;Brick&quot; to the name of the thing u want to get deleted

		wait(5)
		script.Parent.Parent:remove() 

	end
end

script.Parent.Touched:connect(onTouch)

--Side Note: take off the &quot;--[[&quot; and the &quot;--]]&quot; if u want the brick to have animation when deleted</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX2003">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">function onTouched(part)
	if part.Parent ~= nil then
		local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
			if h~=nil then
					local door=script.Parent
					door.Transparency=0.5
					door.CanCollide=false
					wait(3)
					door.Transparency=0
					door.CanCollide=true
			end
	end
end

script.Parent.Touched:connect(onTouched)
</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
