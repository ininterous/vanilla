		<Item class="Script" referent="RBX914">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script Builder</string>
				<string name="Source">--Justgoaway1 made this &gt;:O

function onPlayerRespawned(newPlayer)
		local char = newPlayer.Character
		local a = script:children()
		for i=1, #a do
		if a[i].className == &quot;IntValue&quot; then
		if a[i].Name == newPlayer.Name then
		local g = script.ScriptBuilder:clone()
		g.Parent = char
		g.Disabled = false
end
end
end
end

function onPlayerEntered(newPlayer)
		newPlayer.Changed:connect(function (property)
				if (property == &quot;Character&quot;) then
						onPlayerRespawned(newPlayer)
				end
		end)
end

game.Players.PlayerAdded:connect(onPlayerEntered)
