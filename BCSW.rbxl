				<Item class="Script" referent="RBX213">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">function onTouched(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h~=nil then
		if script.Parent.BrickColor == BrickColor.new(21) then
		h.Parent.Torso.CFrame = CFrame.new(-156, 6.5, -110)
		end
	end
end

script.Parent.Touched:connect(onTouched)</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
			<Item class="Script" referent="RBX214">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ReadMe</string>
					<string name="Source">--[[
thats for using NZ&apos;s Code door.
This door is pretty simple to do if you know how to copy past and type 1-3
first exit this script and Open the &quot;KeyPad&quot; and look for the Script Named &quot;MasterScript&quot;
Then Look At The Very Top For Somthing Called &quot;Code&quot; See the numbers to teh right?
Chage them to your code... Your done! Simple eh? This door is very usful for obsticals with codes

P.S. Just try to move it on its Axis, Dragging it could damage the door.

~~~NZ~~~ (NintendoZACHERY)
--]]</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
