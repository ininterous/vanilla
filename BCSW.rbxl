						<string name="Source">wall = script.Parent
i1 = &quot;http://www.roblox.com/asset/?id=9151126&quot;
i2 = &quot;http://www.roblox.com/asset/?id=8549753&quot;
i3 = &quot;http://www.roblox.com/asset/?id=7317249&quot;
d = wall.Decal

while true do
wait()
if wall.Position.x &gt; 942 then
d.Texture = i1
end

if wall.Position.x &lt;= 942 and wall.Position.x &gt; 431 then
d.Texture = i2
end

if wall.Position.x &lt; 431 then
d.Texture = i3
end

end
