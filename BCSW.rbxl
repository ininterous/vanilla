						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Sense</string>
						<string name="Source">while true do 
wait()
local person = script.Parent.Parent
local d = 14
local p = game.Players:GetChildren()
for i = 1, #p do
local t = p[i]
local c = t.Character
if c ~=nil then
if (c.Torso.Position - script.Parent.Position).magnitude &lt;d and c.Name ~= person.Name then
c.Torso.Velocity = Vector3.new(0,270,0)
wait(0.3)
c.Humanoid.Health = 0
end
end
end
end

</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
		</Item>
