			<Item class="HopperBin" referent="RBX613">
				<Properties>
					<bool name="Active">false</bool>
					<token name="BinType">0</token>
					<string name="Name">Dive</string>
					<Content name="TextureId"><null></null></Content>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="Script" referent="RBX614">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Dive</string>
						<string name="Source">--if game.Workspace.Player:findFirstChild(&quot;Humanoid&quot;)~=nil then print(&quot;hi&quot;) end
bin = script.Parent
power=100
enabled=true
	dude=script.Parent.Parent.Parent.Name
	pl=game.Workspace:findFirstChild(dude)

function onButton1Down(mouse)
	if not enabled then
		return
	end

	enabled = false
	mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;

	local hit = mouse.Hit
	local part=mouse.Target
	dude=script.Parent.Parent.Parent.Name
	pl=game.Workspace:findFirstChild(dude)
	if hit==nil or part==nil or dude==nil or pl==nil then 
	wait(000.1)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	enabled = true
	return 
	end
	


	if pl.Torso.Position~=nil then
		local vertdist=hit.p.y-pl.Torso.Position.y
		if vertdist&gt;14 or vertdist&lt;-10 then
			wait(000.1)
			mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
			enabled = true
			return
		end

		local e=hit.p.x-pl.Torso.Position.x
		local f=hit.p.z-pl.Torso.Position.z
		local mult=1/(math.sqrt((e^2)+(f^2)))
		e=e*mult
		f=f*mult
		
		local factorx=1
		local factory=1
		if part.Name==&quot;Ball&quot; then
			local factory=6
		end
		if part.Parent:findFirstChild(&quot;Humanoid&quot;)~=nil then
			local factorx=2
		end
		
		pl.Torso.Velocity=Vector3.new(e*power*factorx,25*factory,f*power*factorx)
		pl.Torso.RotVelocity=Vector3.new(0.5*f*power*factorx,0,-0.5*e*power*factorx)

	end

	pl.Humanoid.Health=pl.Humanoid.Health-0
	wait(000.1)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	enabled = true

end

function onSelected(mouse)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)
</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
		</Item>
