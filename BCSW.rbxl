						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">function onTouch(part) 
local human = part.Parent:findFirstChild(&quot;Humanoid&quot;) 
if human ~= nil then 
part.Parent:findFirstChild(&quot;Head&quot;).Locked = false
part.Parent:findFirstChild(&quot;Torso&quot;).Locked = false
part.Parent:findFirstChild(&quot;Left Arm&quot;).Locked = false
part.Parent:findFirstChild(&quot;Right Arm&quot;).Locked = false
part.Parent:findFirstChild(&quot;Left Leg&quot;).Locked = false
part.Parent:findFirstChild(&quot;Right Leg&quot;).Locked = false
end 
end 
script.Parent.Touched:connect(onTouch) 
</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
