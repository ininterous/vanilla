					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">model = script.Parent.Parent
B = model.Button
D1 = model.D1
D2 = model.D2
D3 = model.D3
D4 = model.D4
D5 = model.D5

cf1 = D1.CFrame
cf2 = D2.CFrame
cf3 = D3.CFrame
cf4 = D4.CFrame
cf5 = D5.CFrame
cf6 = B.CFrame


local debounce = false


function onTouched(hit)
	local humanoid = hit.Parent
	if humanoid~=nil and debounce == false then
		debounce = true

		wait(0)

		model:MoveTo(Vector3.new(1.32e+003, 17.1, 97))
		wait(3)
		B.CFrame = cf6
		D1.CFrame = cf1
		D2.CFrame = cf2
		D3.CFrame = cf3
		D4.CFrame = cf4
		D5.CFrame = cf5
	
		debounce = false
	end
end


script.Parent.Touched:connect(onTouched)</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
