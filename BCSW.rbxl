					<string name="Name">LocalScript</string>
					<string name="Source">local bin = script.Parent
self = script.Parent.Parent.Parent

function onButton1Down(mouse)
	self.Character:findFirstChild(&quot;Head&quot;).CanCollide = false
	self.Character:findFirstChild(&quot;Torso&quot;).CanCollide = false
	self.Character:findFirstChild(&quot;Right Arm&quot;).CanCollide = false
	self.Character:findFirstChild(&quot;Left Arm&quot;).CanCollide = false
	self.Character:findFirstChild(&quot;Right Leg&quot;).CanCollide = false
	self.Character:findFirstChild(&quot;Left Leg&quot;).CanCollide = false
	self.Character:findFirstChild(&quot;Torso&quot;).Anchored = true
	self.Character:findFirstChild(&quot;Humanoid&quot;).MaxHealth = 
	self.Character:findFirstChild(&quot;Humanoid&quot;).WalkSpeed = 0
	wait(5)
	self.Character:findFirstChild(&quot;Torso&quot;).Anchored = false
	self.Character:findFirstChild(&quot;Head&quot;).CanCollide = true
	self.Character:findFirstChild(&quot;Torso&quot;).CanCollide = true
	self.Character:findFirstChild(&quot;Humanoid&quot;).MaxHealth = 100
	self.Character:findFirstChild(&quot;Humanoid&quot;).Health = 100
	self.Character:findFirstChild(&quot;Humanoid&quot;).WalkSpeed = 16
	script.Parent:remove()
end

function onSelected(mouse)
	print(&quot;select&quot;)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)</string>
