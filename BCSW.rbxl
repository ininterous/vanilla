						<string name="Name">MasterScript</string>
						<string name="Source">Code = &quot;24&quot; --Heres where you put your own code.
Input = &quot;&quot;
Turn = false --Turn Animation On?



------------------------------------------
--Clear And Enter

function Clear()
print(&quot;Cleared&quot;)
Input = &quot;&quot;
end

script.Parent.Clear.ClickDetector.MouseClick:connect(Clear)




function Enter()
if Input == Code then
print(&quot;Entered&quot;)
Input = &quot;&quot;

de = false
local door = script.Parent.Parent.Door

if Turn == false then
if de == true then return end
de = true

door.CanCollide = false
while true do
wait(0.1)
door.Transparency = door.Transparency + 0.1
if door.Transparency &gt;= 0.9 then break end
end
wait(3)--
while true do
wait(0.1)
door.Transparency = door.Transparency - 0.1
if door.Transparency &lt;= 0 then break end
end
door.CanCollide = true
de= false

else

k= 0
while true do
wait()
k = k + 1
door.CFrame = door.CFrame * CFrame.fromEulerAnglesXYZ(0,0.051,0)
if k &gt;= 31 then break end
end
wait(3)
k= 0
while true do
wait()
k = k + 1
door.CFrame = door.CFrame * CFrame.fromEulerAnglesXYZ(0,-0.051,0)
if k &gt;= 31 then break end
end
de = false
end



return end
Input = &quot;&quot;
print(&quot;Wrong Code&quot;)
end




script.Parent.Enter.ClickDetector.MouseClick:connect(Enter)

------------------------------------------
--Digets


function Click0()
Input = Input..0
print(&quot;0&quot;) 
end

script.Parent.B0.ClickDetector.MouseClick:connect(Click0)

function Click1()
Input = Input..1
print(&quot;1&quot;)
end

script.Parent.B1.ClickDetector.MouseClick:connect(Click1)

function Click2()
Input = Input..2
print(&quot;2&quot;)
end

script.Parent.B2.ClickDetector.MouseClick:connect(Click2)

function Click3()
Input = Input..3
print(&quot;3&quot;)
end

script.Parent.B3.ClickDetector.MouseClick:connect(Click3)

function Click4()
Input = Input..4
print(&quot;4&quot;)
end

script.Parent.B4.ClickDetector.MouseClick:connect(Click4)

function Click5()
Input = Input..5
print(&quot;5&quot;)
end

script.Parent.B5.ClickDetector.MouseClick:connect(Click5)

function Click6()
