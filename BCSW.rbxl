						<string name="Name">Script</string>
						<string name="Source">--Made By: NintendoZACHERY
l = script.Parent
while true do
wait()
local h = l:GetChildren()
for i = 1, #h do
if h[i].Name == &quot;Brick&quot; then
h[i].CFrame = h[i].CFrame * CFrame.fromEulerAnglesXYZ(0.02,0.01,0.02)
end
end
end
</string>
