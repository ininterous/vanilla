						<string name="Name">Script</string>
						<string name="Source">while true do 
wait()
script.Parent.Reflectance = script.Parent.Reflectance +0.001
if script.Parent.Reflectance &gt;= 0.7 then 
script.Parent.BrickColor = BrickColor.new(21)
wait(1)
local p = Instance.new(&quot;Explosion&quot;)
p.Parent = game.Workspace
p.BlastRadius = 12
p.Position = script.Parent.Position
script.Parent.Reflectance = 0
script.Parent.BrickColor = BrickColor.new(26)
wait(2)
end
end

</string>
