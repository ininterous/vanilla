						<string name="Name">RegenDistance</string>
						<string name="Source">wall = script.Parent
c = wall.Parent:Clone()

while true do
wait()
if wall.Position.x &lt;= -148 then
wait(3.5)
local clone = c
c.Parent = game.Workspace
c:MakeJoints()
break
end
end

wall.Parent.Parent = nil
