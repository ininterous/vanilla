			<Item class="HopperBin" referent="RBX115">
				<Properties>
					<bool name="Active">false</bool>
					<token name="BinType">0</token>
					<string name="Name">LongHover</string>
					<Content name="TextureId"><null></null></Content>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="Script" referent="RBX116">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Hover</string>
						<string name="Source">--	NintendoZACHERY

bin = script.Parent
de = false
v = 45
hov = Instance.new(&quot;BodyPosition&quot;)
hov.maxForce = Vector3.new(0,100000,0)
hov.position = Vector3.new(0,7,0)

function onButton1Down(mouse)

	local player = game.Players.LocalPlayer
	if player == nil then return end
	if de == true then return end

	if player.Character.Torso:findFirstChild(&quot;BodyPosition&quot;) ~= nil and player:findFirstChild(&quot;Message&quot;) ~= nil then
		player.Character.Torso:findFirstChild(&quot;BodyPosition&quot;):remove()
		player:findFirstChild(&quot;Message&quot;).Parent = nil
		de = true
		wait(5)
		de = false
		v = 45
	else
		hov:clone().Parent =  player.Character.Torso
		v = 45
		local m = Instance.new(&quot;Hint&quot;)
		m.Parent = player
		m.Text = &quot;Time: &quot; .. v
		while m.Parent ~= nil do
		wait(1)
		if v &lt;= 1 then break end
		if player.Character:findFirstChild(&quot;Humanoid&quot;).Health &lt;= 0 then break end
		v = v -1
		m.Text = &quot;Time: &quot; .. v
		end
		m.Parent = nil
		de = true
		if player.Character.Torso:findFirstChild(&quot;BodyPosition&quot;) ~= nil then
		player.Character.Torso:findFirstChild(&quot;BodyPosition&quot;):remove()
		end
		wait(5)
		v = 45
		de = false
	end

	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot; -- Change GunCursor to ArrowCursor if i want a differnt cursor.

end

function onSelected(mouse)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot; -- Change GunCursor to ArrowCursor if i want a differnt cursor.
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)
</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
		</Item>
