				</Properties>
			</Item>
		</Item>
		<Item class="HopperBin" referent="RBX1526">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">SlowDownWall</string>
				<Content name="TextureId"><null></null></Content>
