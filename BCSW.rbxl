		<Item class="HopperBin" referent="RBX1583">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">Crawl</string>
				<Content name="TextureId"><null></null></Content>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="Script" referent="RBX1584">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Move</string>
					<string name="Source">bin = script.Parent
 
bounce = 0
 
 
gyro = Instance.new(&quot;BodyGyro&quot;)
gyro.maxTorque = Vector3.new(4e+007,0,0)
gyro.cframe = CFrame.fromAxisAngle(Vector3.new(0,0,1),math.pi/2)
 
f = Instance.new(&quot;BodyForce&quot;)
f.force = Vector3.new(0,0,0)
 
function onButton1Down(mouse)
 
        local user = script.Parent.Parent.Parent.Character
        if user == nil then return end
 
        if user.Torso:findFirstChild(&quot;BodyGyro&quot;) and user.Torso:findFirstChild(&quot;BodyForce&quot;) ~= nil then
                user.Torso:findFirstChild(&quot;BodyGyro&quot;):remove()
                user.Torso:findFirstChild(&quot;BodyForce&quot;):remove()
                bounce = 0
                user.Torso:findFirstChild(&quot;Left Hip&quot;).MaxVelocity = 0.15
                user.Torso:findFirstChild(&quot;Left Shoulder&quot;).MaxVelocity = 0.15
                user.Torso:findFirstChild(&quot;Right Shoulder&quot;).MaxVelocity = 0.15
                user.Torso:findFirstChild(&quot;Right Hip&quot;).MaxVelocity = 0.15
        else
                gyro:clone().Parent =  user.Torso
                f:clone().Parent =  user.Torso
 
                user.Torso:findFirstChild(&quot;Left Hip&quot;).MaxVelocity = 0
                user.Torso:findFirstChild(&quot;Left Hip&quot;).DesiredAngle = 0
                user.Torso:findFirstChild(&quot;Left Hip&quot;).CurrentAngle = 0
                user.Torso:findFirstChild(&quot;Left Shoulder&quot;).MaxVelocity = 0
                user.Torso:findFirstChild(&quot;Left Shoulder&quot;).DesiredAngle = 0
                user.Torso:findFirstChild(&quot;Left Shoulder&quot;).CurrentAngle = 0
                user.Torso:findFirstChild(&quot;Right Hip&quot;).MaxVelocity = 0
                user.Torso:findFirstChild(&quot;Right Hip&quot;).DesiredAngle = 0
                user.Torso:findFirstChild(&quot;Right Hip&quot;).CurrentAngle = 0
                user.Torso:findFirstChild(&quot;Right Shoulder&quot;).MaxVelocity = 0
                user.Torso:findFirstChild(&quot;Right Shoulder&quot;).DesiredAngle = 0
                user.Torso:findFirstChild(&quot;Right Shoulder&quot;).CurrentAngle = 0
 
        end
end
 
function onKeyDown(key)
        key = key:lower()
        local user = script.Parent.Parent.Parent.Character
 
        if user.Torso:findFirstChild(&quot;BodyGyro&quot;)~=nil and user.Torso:findFirstChild(&quot;BodyForce&quot;)~=nil then
        bounce = 1
 
        if key == &quot;u&quot; and bounce~=0 then
                user.Torso.BodyForce.force = Vector3.new(-1500,0,0)
                wait(0.5)
                user.Torso.BodyForce.force = Vector3.new(0,0,0)
        end
 
        if key == &quot;j&quot; and bounce~=0 then
                user.Torso.BodyForce.force = Vector3.new(1500,0,0)
                wait(0.5)
                user.Torso.BodyForce.force = Vector3.new(0,0,0)
        end
 
        if key == &quot;h&quot; and bounce~=0 then
                user.Torso.BodyForce.force = Vector3.new(0,0,1500)
                wait(0.5)
                user.Torso.BodyForce.force = Vector3.new(0,0,0)
        end
 
        if key == &quot;k&quot; and bounce~=0 then
                user.Torso.BodyForce.force = Vector3.new(0,0,-1500)
                wait(0.5)
                user.Torso.BodyForce.force = Vector3.new(0,0,0)
                end
        end
end
 
function onSelected(mouse)
        mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
        mouse.KeyDown:connect(onKeyDown)
        mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end
 
bin.Selected:connect(onSelected)</string>
