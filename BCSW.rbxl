					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">bin=script.Parent  
function onButton1Down(mouse) 
t= mouse.Target
if t~=nil and t.className == &quot;Part&quot; then 
if t.Parent:findFirstChild(&quot;Humanoid&quot;) then

local p = Instance.new(&quot;BodyPosition&quot;)
p.maxForce = Vector3.new(90000000,90000000,90000000) --Force
if t.Parent.Torso ~=nil then
p.position = t.Parent.Torso.Position + Vector3.new(0,8.5,0)
local user = script.Parent.Parent.Parent.Character
p.Parent = user.Torso
user.Head.CanCollide = false
user.Torso.CanCollide = false

while true do
wait()
user.Torso.BodyPosition.position = t.Parent.Torso.Position + Vector3.new(0,8.5,0)
end

end 
end
end
end

function onSelected(mouse) 
print(&quot;Selected&quot;) 
mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot; 
mouse.Button1Down:connect(function() onButton1Down(mouse) end) 
end
bin.Selected:connect(onSelected)</string>
