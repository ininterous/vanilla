			</Properties>
			<Item class="Script" referent="RBX1527">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">SlowScript</string>
					<string name="Source">bin = script.Parent

function onButton1Down(mouse)
	mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
	local hit = mouse.Target
	if (hit == nil) then return end
	if (hit.Name == &quot;BigEngine&quot;) and hit.BodyForce.force == Vector3.new(-55000000,0,0) then
	hit.BodyForce.force = Vector3.new(-220000,0,0)
	wait(0.2)
	hit.BodyForce.force = Vector3.new(-55000000,0,0)

	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	end

	if (hit.Name == &quot;SecretTeleII&quot;) then
	script.Parent.Parent.Parent.Character.Torso.CFrame = hit.Parent.Spawn.CFrame
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	end
end



function onSelected(mouse)
	print(&quot;Action Tool Selected&quot;)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)


--[[bin = script.Parent

function onButton1Down(mouse)
	mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
	local hit = mouse.Target
	if (hit == nil) then return end
	if (hit.Name == &quot;BigEngine&quot;) then
	hit.BodyForce.force = Vector3.new(-550000,0,0)
	wait(0.5)
	hit.BodyForce.force = Vector3.new(-55000000,0,0)

	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	end
end



function onSelected(mouse)
	print(&quot;Action Tool Selected&quot;)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)
--]]
