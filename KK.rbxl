customer = game.Workspace.CustomerClone.IsOrdering
function onTouched(part)

if part.Parent.Name == &quot;Table&quot; then

children = part.Parent.Parent:children()
for i = 1, #children do 
if children[i].className == &quot;Model&quot; then

if children[i].Name == &quot;krabby patty and a pepsi&quot; then
burger = script.Parent.Parent:findFirstChild(&quot;Burger&quot;)
pepsi = script.Parent.Parent:findFirstChild(&quot;pepsi&quot;)
if burger and pepsi~=nil then
script.Parent.Anchored = true
kpandp.Value = kpandp.Value - 1
children[i].Name = &quot;thank you!&quot;
wait(2)
burger:remove()
wait(2)
pepsi:remove()
wait(2)
script.Parent.Anchored = false
children[i].Name = &quot;&quot;
children[i].Head.face:remove()
children[i].Head.Transparency = 1
children[i].Torso.Transparency = 1
children[i].Lleg.Transparency = 1
children[i].Larm.Transparency = 1
children[i].Rleg.Transparency = 1
children[i].Rarm.Transparency = 1
if tablestaken.Value == 6 then
customer.Value = false
end
tablestaken.Value = tablestaken.Value - 1
end
childrens = game.Players:children()
for i = 1, #childrens do 
childrens[i].leaderstats.Money.Value = childrens[i].leaderstats.Money.Value + childrens[i].money.Value
end
end

if children[i].Name == &quot;just a krabby patty&quot; then
burger = script.Parent.Parent:findFirstChild(&quot;Burger&quot;)
pepsi = script.Parent.Parent:findFirstChild(&quot;pepsi&quot;)
