			<Item class="Script" referent="RBX113">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">function onTouched(part)
print(part.Parent)
if part.Parent~=nil then
if part.Parent.Name == &quot;PaCrate&quot; then
local crate = part.Parent:children()
local patty = part.Parent.Parent:children()
script.Parent.CanCollide = false
wait(2)
script.Parent.CanCollide = true
for i = 1, #crate do
crate[i]:remove()
end
for i = 1, #patty do
if patty[i].Name == &quot;Patty&quot; then
patty[i].Parent = game.Workspace
patty[i]:breakJoints()
end
end
end
end
end

script.Parent.Touched:connect(onTouched)</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
