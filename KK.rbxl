						<string name="Source">
function onChanged(property)
if property == &quot;DraggingV1&quot; then

local children =  game.Workspace:children()
for i = 1, #children do
if children[i].Name == &quot;Burger&quot; and children[i].className == &quot;Model&quot; then
local chk = children[i]:findFirstChild(&quot;Lettuce&quot;)
local chk2 = children[i]:findFirstChild(&quot;Bun2&quot;)
if chk~=nil and chk2==nil then
local x = script.Parent.Position.x - chk.Position.x
local y = script.Parent.Position.y - chk.Position.y
local z = script.Parent.Position.z - chk.Position.z
if x == 0 and y &lt; 0.5 and y &gt; 0 and z == 0 then
print(x, y, z)
print(&quot;attaching&quot;)
script.Parent.Name = &quot;Bun2&quot;
script.Parent.Parent = children[i]
end
end
end
if children[i].Name == &quot;Tray&quot; and children[i].className == &quot;Model&quot; and script.Parent.Parent.Parent ~= children[i] then
local BurgerCheck = children[i]:findFirstChild(&quot;Burger&quot;)
local BunChk = script.Parent.Parent:findFirstChild(&quot;Bun2&quot;)
if BurgerCheck==nil and BunChk~=nil then
local x2 = script.Parent.Position.x - children[i].trey.Position.x
local y2 = script.Parent.Position.y - children[i].trey.Position.y
local z2 = script.Parent.Position.z - children[i].trey.Position.z
if x2 &gt;= -1 and x2 &lt;= 1 and y2 &lt; 0.5 and z2 &gt;= -2 and z2 &lt;= 2 then
script.Parent.Parent.Parent = children[i]
print(&quot;found tray&quot;)
end
end
end
end
end
end

