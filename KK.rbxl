						<string name="Source">function onChanged(property)
print(property)
print(game.Workspace.PattyAndPepsiOrders.Value, &quot;number&quot;)
local numa = script.Parent:findFirstChild(game.Workspace.PattyAndPepsiOrders.Value)
local children = script.Parent:children()
for i = 1, #children do
if children[i].className ~=&quot;StringValue&quot; and children[i].className ~=&quot;Script&quot; and children[i].Face == 1 then
children[i].Face = 4
end
end
if numa~=nil then
numa.Face = 1 --4 = Bottom 1 = Top
print(numa.Face, &quot;face&quot;)
end
end
game.Workspace.PattyAndPepsiOrders.Changed:connect(onChanged)</string>
