			<Item class="Script" referent="RBX108">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">function onTouched(part)
print(part.Parent)
if part.Parent~=nil then
if part.Parent.Name == &quot;PCrate&quot; then
local crate = part.Parent:children()
local Pepsi = part.Parent.Parent:children()
script.Parent.CanCollide = false
wait(2)
script.Parent.CanCollide = true
for i = 1, #crate do
crate[i]:remove()
end
for i = 1, #Pepsi do
if Pepsi[i].Name == &quot;pepsi&quot; then
Pepsi[i].Parent = game.Workspace
Pepsi[i]:breakJoints()
end
end
end
end
end

script.Parent.Touched:connect(onTouched)</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
