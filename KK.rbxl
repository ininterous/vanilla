					<string name="Name">Script</string>
					<string name="Source">manager = game.Workspace.Manager
function onTouch(part)
local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
if h~=nil then
local plr = game.Players:findFirstChild(h.Parent.Name)
if plr~=nil then
local backpack = plr.Backpack
local child = backpack:children()
for i =1, #child do
if plr.TeamColor ~= script.Parent.BrickColor then
child[i]:remove()
end
end
local chk2 = backpack:findFirstChild(&quot;TakeOrder&quot;)
if chk2==nil then
local order = script.Parent.TakeOrder:clone()
order.Parent = plr.Backpack
end
local chk = backpack:findFirstChild(&quot;HopperBin&quot;)
if chk==nil then
local drag = script.Parent.HopperBin:clone()
drag.Parent = plr.Backpack
end
end
if manager.Value==h.Parent.Name then
manager.Value = &quot;&quot;
wait()
game.Teams:findFirstChild(&quot;Mr. Krabs/Manager&quot;).AutoAssignable = true
game.Workspace.MrKrabs.AllowTeamChangeOnTouch = true
end
end
end
script.Parent.Touched:connect(onTouch)</string>
