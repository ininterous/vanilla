							<string name="Name">Script</string>
							<string name="Source">function onTouch(part)
local clone = script.Parent.Parent.FPepsi:clone()
clone.Parent = game.Workspace
clone.CFrame = script.Parent.Parent.FPepsi.CFrame+Vector3.new(0,2,0)
clone.Anchored = false
clone.CanCollide =true
end

script.Parent.Touched:connect(onTouch)</string>
