			<Item class="Script" referent="RBX725">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">print(&quot;Trapdoor loaded&quot;)

local trapdoor = script.Parent

while true do

wait(10) --Standby for 10 seconds

trapdoor.Transparency = 1
trapdoor.CanCollide = false  --Make trapdoor disappear and have anyone on the brick fall through

wait(1)

trapdoor.Transparency = 0
trapdoor.CanCollide = true  --Return brick to normal condition
end
</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX726">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">
function onTouched(hit)
	local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (human ~= nil) then
		human.Health = 0
	end
end

if (script.Parent ~= nil) and (script.Parent.className == &quot;Part&quot;) then --Work if in a block
	connection = script.Parent.Touched:connect(onTouched)
end
</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX727">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">function onTouched(hit)
if hit.Parent.Name ~= &quot;Tray&quot; then hit:remove() end
end

connection = script.Parent.Touched:connect(onTouched)
</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
