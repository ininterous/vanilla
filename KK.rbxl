					<string name="Name">Script</string>
					<string name="Source">function onTouch(part)
if part.Name == &quot;Carrier&quot; then
part.Parent.CanRecieve.Value = true
elseif part.Name == &quot;BackPart&quot; then
part.Parent.CanRecieve.Value = false
end
end

script.Parent.Touched:connect(onTouch)</string>
