					<string name="Source">count = 0
while true do
wait(1)
local ch = game.Workspace:children()
for i = 1, #ch do
if ch[i].className == &quot;Part&quot; and ch[i].Name == &quot;pepsi&quot; then
count = count+1
end
end
if count &lt; 5 then
script.Parent.CanCollide = false
else script.Parent.CanCollide = true
end
count = 0
end
