		<Item class="Script" referent="RBX573">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">RemoveEmptyBurgers</string>
				<string name="Source">while true do
wait(1) -- every second, the script looks for burger models, if the model has no children, it gets deleted.
local children = game.Workspace:children()
for i = 1, #children do
if children[i].Name == &quot;Burger&quot; and children[i].className == &quot;Model&quot; then
local bchildren = children[i]:children()
if #bchildren == 0 then
children[i]:remove()
end
end
end
end
</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
