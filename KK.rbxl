				<Item class="Script" referent="RBX1430">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">
function onChanged(property)
if property == &quot;DraggingV1&quot; then

local children =  game.Workspace:children()
for i = 1, #children do
if children[i].Name == &quot;Tray&quot; and children[i].className == &quot;Model&quot; and script.Parent.Parent ~= children[i] then
local PepsiCheck = children[i]:findFirstChild(&quot;pepsi&quot;)
if PepsiCheck==nil then
local x2 = script.Parent.Position.x - children[i].trey.Position.x
local y2 = script.Parent.Position.y - children[i].trey.Position.y
local z2 = script.Parent.Position.z - children[i].trey.Position.z
if x2 &gt;= -1.5 and x2 &lt;= 1.5 and y2 &lt; 0.8 and z2 &gt;= -2.5 and z2 &lt;= 2.5 then
script.Parent.Parent = children[i]
print(&quot;found tray&quot;)
end
end
end
end
end
end

connection = script.Parent.Changed:connect(onChanged)</string>
