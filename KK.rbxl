				<string name="Source">print(&quot;Custom Leaderboard running!&quot;)

function onPlayerEntered(newPlayer)

	local stats = Instance.new(&quot;IntValue&quot;)
	stats.Name = &quot;leaderstats&quot;

	local cash = Instance.new(&quot;IntValue&quot;)
	cash.Name = &quot;Money&quot;
	cash.Value = 0

	local money = Instance.new(&quot;IntValue&quot;)
	money.Name = &quot;money&quot;
	money.Value = 10


	cash.Parent = stats
	money.Parent = newPlayer
	stats.Parent = newPlayer

	wait(1)
	if newPlayer.TeamColor == BrickColor.new(&quot;Bright red&quot;) then
	game.Teams:findFirstChild(&quot;Mr. Krabs/Manager&quot;).AutoAssignable = false
	game.Workspace.MrKrabs.AllowTeamChangeOnTouch = false
	end
end

