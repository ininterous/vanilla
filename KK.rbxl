						<string name="Source">
function onChanged(property)
if property == &quot;DraggingV1&quot; then

local children =  game.Workspace:children()
for i = 1, #children do
if children[i].Name == &quot;Grill&quot; and children[i]~=nil and script.Parent.Name == &quot;Patty&quot; then
local x = script.Parent.Position.x - children[i].Position.x
local y = script.Parent.Position.y - children[i].Position.y
local z = script.Parent.Position.z - children[i].Position.z
if x &lt;= 1.5 and x &gt;= -1.5 and y&lt;=1 and z &lt;= 3 and z &gt;= -3 then
script.Parent.Locked = true
print(&quot;grilling&quot;)
local h = Instance.new(&quot;Humanoid&quot;)
local model = Instance.new(&quot;Model&quot;)
model.Name = &quot;Grilling.&quot;
script.Parent.Name = &quot;Head&quot;
script.Parent.Parent = model
local gscript = script.Parent.grillscript:clone()
gscript.Disabled = false
gscript.Parent = h
h.Parent = model
model.Parent = game.Workspace
connection:disconnect()
end
end
if children[i].Name == &quot;Burger&quot; and children[i].className == &quot;Model&quot; and script.Parent.Name == &quot;CookedPatty&quot; then
local chk = children[i]:findFirstChild(&quot;Bun&quot;)
local chk2 = children[i]:findFirstChild(&quot;CookedPatty&quot;)
if chk~=nil and chk2==nil then
local x2 = script.Parent.Position.x - chk.Position.x
local y2 = script.Parent.Position.y - chk.Position.y
local z2 = script.Parent.Position.z - chk.Position.z
if x2 == 0 and y2 &lt; 0.5 and z2 == 0 then
print(&quot;attaching&quot;)
script.Parent.Parent = children[i]
end
end
end
end

end

end

connection = script.Parent.Changed:connect(onChanged)</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX952">
					<Properties>
