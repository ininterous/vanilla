				<Item class="Script" referent="RBX695">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">function onChanged(property)
print(property)
print(game.Workspace.PepsiOrders.Value, &quot;number&quot;)
local numa = script.Parent:findFirstChild(game.Workspace.PepsiOrders.Value)
local children = script.Parent:children()
for i = 1, #children do
if children[i].className ~=&quot;StringValue&quot; and children[i].className ~=&quot;Script&quot; and children[i].Face == 1 then
children[i].Face = 4
end
end
if numa~=nil then
numa.Face = 1 --4 = Bottom 1 = Top
print(numa.Face, &quot;face&quot;)
end
end

game.Workspace.PepsiOrders.Changed:connect(onChanged)</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
