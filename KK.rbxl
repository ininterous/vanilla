			<Item class="Script" referent="RBX1622">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">count = 0
while true do
wait(1)
local ch = game.Workspace:children()
for i = 1, #ch do
if ch[i].className == &quot;Model&quot; and ch[i].Name == &quot;Burger&quot; then
local bch = ch[i]:children()
if #bch == 1 then
count = count+1
end
end
end
if count &lt; 8 then
script.Parent.CanCollide = false
else script.Parent.CanCollide = true
end
count = 0
end
</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
