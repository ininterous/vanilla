				<Item class="Script" referent="RBX1591">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">function onTouch(part)
if part.Parent.Parent.Name == &quot;PepsCrate&quot; then
part.Parent.Parent.Name = &quot;PepsiCrate&quot;
box = part.Parent.Parent
wait(1)
local car = game.Workspace.SuplierCar2
if car.CanRecieve.Value == true then
box:moveTo(car.Carrier.Position)
else box:moveTo(game.Workspace.SupplyBox2.Box.Position)
end
box:makeJoints()
end
end

script.Parent.Touched:connect(onTouch)</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
