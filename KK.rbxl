function onTouch(part)
local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
if h~=nil then
if script.Parent.AllowTeamChangeOnTouch==true then
manager.Value = h.Parent.Name
wait()
game.Teams:findFirstChild(&quot;Mr. Krabs/Manager&quot;).AutoAssignable = false
script.Parent.AllowTeamChangeOnTouch=false
end
end
