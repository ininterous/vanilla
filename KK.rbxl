			</Item>
			<Item class="HopperBin" referent="RBX601">
				<Properties>
					<bool name="Active">false</bool>
					<token name="BinType">2</token>
					<string name="Name">HopperBin</string>
					<Content name="TextureId"><url>rbxasset://Textures\gameTool.png</url></Content>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="HopperBin" referent="RBX602">
				<Properties>
					<bool name="Active">false</bool>
					<token name="BinType">0</token>
					<string name="Name">TakeOrder</string>
					<Content name="TextureId"><null></null></Content>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="Script" referent="RBX603">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">bin = script.Parent
orders = {&quot;krabby patty and a pepsi&quot;, &quot;just a krabby patty&quot;, &quot;just a pepsi&quot;}
tables = {game.Workspace.Table1, game.Workspace.Table2, game.Workspace.Table3, game.Workspace.Table4, game.Workspace.Table5, game.Workspace.Table6}
customerclone = game.Workspace.CustomerClone
kpandp = game.Workspace.PattyAndPepsiOrders
kp = game.Workspace.PattyOrders
p = game.Workspace.PepsiOrders
tablestaken = game.Workspace.TablesTaken

debounce = false
function gettable(customer)
table = tables[math.random(1, #tables)]
local chk = table:findFirstChild(&quot;&quot;)
if chk~=nil then
local children = chk:children()
for i = 1, #children do
if children[i].Name~=&quot;Humanoid&quot; then
children[i].Transparency = 0
end
end
local face = customer.Head.face:clone()
face.Parent = chk.Head
chk.Head.BrickColor = customer.Head.BrickColor
chk.Torso.BrickColor = customer.Torso.BrickColor
chk.Larm.BrickColor = customer.Torso.BrickColor
chk.Rarm.BrickColor = customer.Torso.BrickColor
chk.Name = customer.Name
tablestaken.Value = tablestaken.Value + 1
else
gettable(customer)
end
end

function takeOrder(target)
print(target.Parent.Name)
if target.Parent.Name == &quot;Customer&quot; and debounce == false then
print(&quot;got customer&quot;)
debounce = true
target.Parent.Name = orders[math.random(1, #orders)]


if target.Parent.Name == &quot;krabby patty and a pepsi&quot; then
kpandp.Value = kpandp.Value + 1
end

if target.Parent.Name == &quot;just a krabby patty&quot; then
kp.Value = kp.Value + 1
end

if target.Parent.Name == &quot;just a pepsi&quot; then
p.Value = p.Value + 1
end

wait(4)
gettable(target.Parent)
target.Parent:remove()
if tablestaken.Value &lt; 6 then
customerclone.IsOrdering.Value = false
end
debounce = false
end
end


function onButton1Down(mouse)

local target = mouse.Target

if target~=nil then

	mouse.Icon = &quot;rbxasset://textures\\ArrowFarCursor.png&quot;
	takeOrder(target)
	wait(0.2)
	mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;

end
end

function onSelected(mouse)
	print(&quot;selected&quot;)

	mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;

	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)

