		<Item class="Script" referent="RBX304">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">CustomerScript</string>
				<string name="Source">rot = CFrame.new(0, 0, 0, 0, 0, 1, 0, 1, 0, -1, 0, 0)
colors = {&quot;Bright red&quot;, &quot;Bright blue&quot;, &quot;Earth green&quot;, &quot;Dark green&quot;, &quot;Bright green&quot;, &quot;Medium blue&quot;, &quot;Bright bluish green&quot;}

while true do
wait(math.random(10, 20))
local chk = game.Workspace.CustomerClone.IsOrdering
if chk.Value == false then
chk.Value = true
model = Instance.new(&quot;Model&quot;)
model.Name = &quot;Customer&quot;
model.Parent = game.Workspace

local clon1 = chk.Parent.Torso:clone()
clon1.CFrame = CFrame.new(-3.5, 3.8, -5) * rot
clon1.BrickColor = BrickColor.new(colors[math.random(1, #colors)] )
clon1.Parent = model

local clon2 = chk.Parent.Head:clone()
clon2.CFrame = CFrame.new(-3.5, 5.3, -5) * rot
clon2.BrickColor = BrickColor.new(clon1.Color)
clon2.Parent = model

local clon3 = chk.Parent:findFirstChild(&quot;Left Leg&quot;):clone()
clon3.CFrame = CFrame.new(-3.5, 1.8, -4.5)
clon3.Parent = model

local clon4 = chk.Parent:findFirstChild(&quot;Right Leg&quot;):clone()
clon4.CFrame = CFrame.new(-3.5, 1.8, -5.5)
clon4.Parent = model

local clon5 = chk.Parent:findFirstChild(&quot;Right Arm&quot;):clone()
clon5.CFrame = CFrame.new(-3.5, 3.8, -6.5)
clon5.BrickColor = BrickColor.new(clon1.Color)
clon5.Parent = model

local clon6 = chk.Parent:findFirstChild(&quot;Left Arm&quot;):clone()
clon6.CFrame = CFrame.new(-3.5, 3.8, -3.5)
clon6.BrickColor = BrickColor.new(clon1.Color)
clon6.Parent = model

local clon7 = chk.Parent.Humanoid:clone()
clon7.Parent = model

end
end
</string>
