			</Item>
			<Item class="HopperBin" referent="RBX1340">
				<Properties>
					<bool name="Active">false</bool>
					<token name="BinType">2</token>
					<string name="Name">HopperBin</string>
					<Content name="TextureId"><url>rbxasset://Textures\gameTool.png</url></Content>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="HopperBin" referent="RBX1341">
				<Properties>
					<bool name="Active">false</bool>
					<token name="BinType">0</token>
					<string name="Name">Drive</string>
					<Content name="TextureId"><null></null></Content>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="Script" referent="RBX1342">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">bin = script.Parent
lfs = 0.5
rfs = -0.5
mode = 1
driver = 0
tar = nil
function Drive(tar)
if mode == 1 then
tar.BL.RightParamB = lfs
tar.FL.RightParamB = lfs
tar.BR.LeftParamB = rfs
tar.FR.LeftParamB = rfs
elseif mode == 0 then
tar.BL.RightParamB = rfs
tar.FL.RightParamB = rfs
tar.BR.LeftParamB = lfs
tar.FR.LeftParamB = lfs
end
end

function onButton1Up(mouse)
if driver == 1 and tar~=nil then
tar.BL.RightParamB = 0
tar.FL.RightParamB = 0
tar.BR.LeftParamB = 0
tar.FR.LeftParamB = 0
tar.fp.Velocity = Vector3.new(0,0,0)
tar.Carrier.Velocity = Vector3.new(0,0,0)
tar.Seat.Velocity = Vector3.new(0,0,0)
driver = 0
tar.HasDriver.Value = false
tar = nil
end
end

function onButton1Down(mouse)

local target = mouse.Target

if target~=nil then
if target.Parent.Name == &quot;SuplierCar2&quot; then
if (game.Players.LocalPlayer.Character.PrimaryPart.Position - target.Parent.Seat.Position).magnitude &lt; 6 and target.Parent.HasDriver.Value == false then
Drive(target.Parent)
tar = target.Parent
target.Parent.HasDriver.Value = true
driver = 1
end
end
end
	mouse.Icon = &quot;rbxasset://textures\\ArrowFarCursor.png&quot;
	wait(0.2)
	mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
end

function onKeyDown(key) 
if key == &quot;q&quot; then
if mode == 1 then
mode = 0
elseif mode == 0 then
mode = 1
end
end
end 

function onSelected(mouse)
	print(&quot;selected&quot;)

	mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
	        mouse.KeyDown:connect(onKeyDown)
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	mouse.Button1Up:connect(function() onButton1Up(mouse) end)
end

bin.Selected:connect(onSelected)

