			<Item class="Script" referent="RBX579">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">function onTouched(part)
print(part.Parent)
if part.Parent~=nil then
if part.Parent.Name == &quot;BCrate&quot; then
local crate = part.Parent:children()
local burgers = part.Parent.Parent:children()
script.Parent.CanCollide = false
wait(1)
script.Parent.CanCollide = true
for i = 1, #crate do
crate[i]:remove()
end
for i = 1, #burgers do
if burgers[i].Name == &quot;Burger&quot; then
burgers[i].Parent = game.Workspace
burgers[i].Bun:breakJoints()
end
end
end
end
end

