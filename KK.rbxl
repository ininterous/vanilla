							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">hit = 0
function onTouch(part)
if part.Name == &quot;FBun&quot; then
part:remove()
hit = hit+1
print(hit)
if hit == 28 then
hit = 0
clone = game.Workspace.PattCrate:clone()
game.Workspace.PattCrate.PaCrate.Bottom.Anchored = false
wait(3)
clone.Parent = game.Workspace
clone:makeJoints()
end
end
end

